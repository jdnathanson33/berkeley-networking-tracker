# Copy this file to .env.local and fill in the real values from the Neon Console.
# .env.local is gitignored. Never commit real secrets.

# ---- Public: shipped to the browser, protected by Row Level Security ----
# Neon Console -> Auth -> Configuration
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
# Neon Console -> Data API
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example.apirest.region.aws.neon.tech/neondb/rest/v1

# ---- Server-only: never prefixed with NEXT_PUBLIC_, never sent to the browser ----
# Same value as NEXT_PUBLIC_NEON_AUTH_URL; read by the server-side auth handler.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
# Signs the session cookie. Generate with: openssl rand -hex 32   (min 32 chars)
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Direct Postgres connection. Used only for applying db/schema.sql, never at runtime.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
